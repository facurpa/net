# SACC .NET — variáveis de ambiente (mesmos nomes do .env legado Python).
# Copie para .env e ajuste. O loader (Core/DotEnv.cs) lê este arquivo no startup.

# --- Banco de configuração (PostgreSQL) ---
# Aceita o formato SQLAlchemy legado; é convertido para Npgsql automaticamente.
# A senha vem URL-encoded (Cast%402026%21 = Cast@2026!).
DATABASE_URL=postgresql+asyncpg://sacc:Cast%402026%21@localhost:5432/sacc_db

# --- ERP TOTVS (SQL Server, read-only) ---
ERP_DATABASE_URL=mssql+aioodbc://leitor:senha@erp-host:1433/db_integ_intranet?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&Encrypt=yes

# --- JWT / segurança ---
# MESMA chave da versão Python (interop de token). Mínimo 32 chars.
SECRET_KEY=IgzmX12tdiF-Ib1w_BlYnEhRlzhtcaL4Ce3vufSJtWs
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# --- Bootstrap admin (remover após 1º login) ---
INITIAL_ADMIN_EMAIL=admin@cast4it.local
INITIAL_ADMIN_PASSWORD=TroqueEstaSenha2026
INITIAL_ADMIN_NOME=Administrador

# --- SMTP ---
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=sacc@cast4it.com

# --- Ambiente / web ---
ENV=dev
CORS_ORIGINS=http://localhost:3000

# --- Worker ---
WORKER_CRON_HOUR=7
WORKER_CRON_MINUTE=0
RUN_SCHEDULER=false
INCIDENT_ALERT_EMAILS=
INCIDENT_ON_CONFIG_MISSING=true
# Idempotência diária: execução AGENDADA não roda 2x no mesmo dia (fuso São Paulo). Manual nunca bloqueia.
SKIP_SE_JA_EXECUTADO_HOJE=true

# --- Pool PostgreSQL (mapeado para o pool nativo do Npgsql) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# --- Pool/timeouts ERP (mapeado para Microsoft.Data.SqlClient) ---
ERP_POOL_MAX=4
ERP_POOL_TIMEOUT=30
ERP_CONNECT_TIMEOUT=10
ERP_QUERY_TIMEOUT=30

# --- Paridade (Seção 13.3): balancete público; o guard aborta o boot em prod ---
BALANCETE_PUBLIC=true

# Ignorados (paridade): a aplicação NÃO usa Redis nem LDAP.
# REDIS_URL=
# LDAP_*=
