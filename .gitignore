###############################################################################
# .gitignore — SACC API (.NET 8 / C# / Dapper / JWT)
###############################################################################

#######################################
# Segredos e configuração de ambiente
#######################################
# NUNCA versionar arquivos com SECRET_KEY, senhas SMTP, credenciais do ERP/DB,
# INITIAL_ADMIN_PASSWORD, etc.
.env
.env.*
!.env.example
*.env
.env.temp
.env.local
.env.development
.env.production
appsettings.*.local.json
secrets.json
*.secrets.json

# User Secrets do .NET (dotnet user-secrets) — o secrets.json fica fora do repo
# por padrão, mas ignoramos caches locais por garantia.
**/secrets/

